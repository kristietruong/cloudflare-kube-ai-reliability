{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "kube-ai-reliability",
  "main": "src/worker.ts",
  "compatibility_date": "2025-02-20",
  "assets": {
    "directory": "./public"
  },
  // R2 is deferred until storage is enabled on the Cloudflare account.
  // "r2_buckets": [
  //   {
  //     "binding": "K8S_MOCK_LOGS",
  //     "bucket_name": "k8smocklogs",
  //     "remote": true
  //   }
  // ],
  "observability": {
    "enabled": true
  },
  "d1_databases": []
}
